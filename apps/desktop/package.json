{
  "name": "@sigil-ai/desktop",
  "version": "0.0.1-alpha.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:catalog": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ui:check": "../../scripts/check-desktop-ui-system.sh",
    "contract:generate": "../../scripts/generate-desktop-contract.sh --write",
    "contract:check": "../../scripts/generate-desktop-contract.sh --check",
    "sidecar:prepare": "node ../../scripts/prepare-desktop-sidecar.mjs",
    "sidecar:test": "node ../../scripts/test-prepare-desktop-sidecar.mjs",
    "check": "pnpm contract:check && pnpm ui:check && pnpm typecheck && pnpm test && pnpm build",
    "package": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "package:macos:signed": "../../scripts/package-desktop-macos-local.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dompurify": "3.4.12",
    "katex": "0.18.1",
    "mermaid": "11.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "js-yaml": "4.3.0"
    }
  }
}
