{
  "name": "@sigil-ai/desktop",
  "version": "0.0.1-beta.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:catalog": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:desktop:build": "cargo build -p sigil && tauri build --debug --no-bundle --features desktop-e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e:desktop": "pnpm e2e:desktop:build && wdio run ./e2e/wdio.conf.ts",
    "ui:check": "../../scripts/check-desktop-ui-system.sh",
    "contract:generate": "../../scripts/generate-desktop-contract.sh --write",
    "contract:check": "../../scripts/generate-desktop-contract.sh --check",
    "sidecar:prepare": "node ../../scripts/prepare-desktop-sidecar.mjs",
    "sidecar:test": "node ../../scripts/test-prepare-desktop-sidecar.mjs",
    "check": "pnpm contract:check && pnpm ui:check && pnpm typecheck && pnpm test && pnpm build",
    "package": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "package:updater": "tauri build --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.updater.conf.json",
    "package:macos:signed": "../../scripts/package-desktop-macos-local.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dompurify": "3.4.14",
    "katex": "0.18.4",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@wdio/cli": "9.27.1",
    "@wdio/cucumber-framework": "9.31.2",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.4",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@cucumber/messages>uuid": "11.1.1",
      "@puppeteer/browsers": "3.2.1",
      "@wdio/native-utils": "2.5.0",
      "brace-expansion": "5.0.9",
      "cheerio>undici": "7.29.0",
      "js-yaml": "4.3.1",
      "jsdom>undici": "7.29.0",
      "deepmerge-ts": "8.0.0",
      "postcss": "8.5.23",
      "postcss>nanoid": "3.3.18",
      "tmp": "0.2.7"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch"
    }
  }
}
