{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": { "headless": true },
    "contextOptions": { "viewport": { "width": 1280, "height": 800 } }
  },
  "network": { "allowedOrigins": ["http://127.0.0.1:*", "http://localhost:*"] },
  "outputDir": "artifacts",
  "timeouts": { "action": 5000, "navigation": 15000 }
}
